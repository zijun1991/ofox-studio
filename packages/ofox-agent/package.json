{
  "name": "@ofox/agent",
  "version": "1.0.0",
  "description": "OFOX Agent - AI Agent with MCP, Skills, Memory and Session Compression",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cherrystudio/ai-core": "workspace:*",
    "ai": "^5.0.26",
    "lokijs": "^1.5.12",
    "nanoid": "^5.0.0",
    "yaml": "^2.3.0"
  },
  "peerDependencies": {
    "electron": ">=28.0.0"
  },
  "devDependencies": {
    "@types/lokijs": "^1.5.14",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsdown": "^0.20.3",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "llm",
    "electron"
  ],
  "license": "MIT"
}
